# Server secrets: never prefix these with VITE_.
DATABASE_URL=
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
ALLOWED_ORIGINS=http://localhost:5173
PORT=3001
# Only public service URLs belong in Vite config.
VITE_API_URL=http://localhost:3001
